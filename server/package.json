{
  "name": "tappilot-mcp",
  "version": "0.3.19",
  "private": true,
  "type": "module",
  "description": "Desktop phone-agent runtime with an optional MCP accessibility bridge",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "approve": "node dist/approve.js",
    "test": "tsx --test test/*.test.ts",
    "diagnostics": "node dist/diagnostics/cli.js",
    "eval": "node dist/eval/cli.js",
    "learning": "node dist/learning/cli.js",
    "repair": "node dist/repair/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
