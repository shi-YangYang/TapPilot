    { "id": "native_reorder_refresh", "kind": "tap", "change": "armed", "expected": "success" },
    { "id": "native_replaced", "kind": "tap", "change": "armed", "expected": "refusal", "baselinePolicy": "original_selector" },
    { "id": "native_ambiguous", "kind": "tap", "change": "armed", "expected": "refusal", "baselinePolicy": "unique_selector" },
    { "id": "native_context", "kind": "tap", "change": "armed", "expected": "refusal", "baselinePolicy": "explicit_recipient_assertion" },
    { "id": "reliability_delayed_input", "kind": "delayed_input", "expected": "success" },
    { "id": "reliability_silent_input", "kind": "delayed_input", "expected": "success" },
    { "id": "reliability_toggle", "kind": "toggle", "expected": "success" },
    { "id": "reliability_noop", "kind": "noop", "expected": "unverified" },
    { "id": "reliability_input_transform", "kind": "transformed_input", "expected": "unverified" }
  ]
