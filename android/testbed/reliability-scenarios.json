{
  "schemaVersion": 1,
  "package": "dev.tappilot.testbed",
  "activity": "dev.tappilot.testbed/.MainActivity",
  "oraclePath": "files/oracle.json",
  "baseline": "androidx.test.uiautomator:uiautomator:2.3.0",
  "scenarios": [
