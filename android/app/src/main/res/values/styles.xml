<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TapPilot" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#101010</item>
        <item name="android:colorBackground">#181818</item>
        <item name="android:colorBackgroundFloating">#202020</item>
        <item name="android:textColorPrimary">#F4F4F4</item>
        <item name="android:textColorSecondary">#A0A0A0</item>
        <item name="android:textColorHint">#A0A0A0</item>
        <item name="android:colorAccent">#F4F4F4</item>
        <item name="android:colorControlActivated">#F4F4F4</item>
        <item name="android:colorControlNormal">#A0A0A0</item>
        <item name="android:colorButtonNormal">#202020</item>
        <item name="android:statusBarColor">#101010</item>
        <item name="android:navigationBarColor">#101010</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.TapPilot.Dialog</item>
